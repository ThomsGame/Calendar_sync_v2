# ============================================================
# Calendar Sync Dashboard — Environment Variables
# Copy to .env.dashboard and fill in values
# ============================================================

# Flask secret key (used for session cookies)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# Credential encryption key (Fernet)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DASHBOARD_SECRET_KEY=change-me-to-a-fernet-key

# Database (SQLite by default, use postgresql://... for Postgres)
DATABASE_URL=sqlite:///dashboard.db

# Admin account (created automatically on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Google OAuth2 (from Google Cloud Console)
# Required for multi-user Google Calendar authorization
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/setup/google/callback

# Flask debug mode (set to false in production)
FLASK_DEBUG=false

# Port
PORT=5000
