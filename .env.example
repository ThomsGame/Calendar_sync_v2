# =============================================================================
# Calendar Sync — CLI configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ── Snexi ─────────────────────────────────────────────────────────────────────
SNEXI_URL=https://snexi.fr/portail
SNEXI_USERNAME=
SNEXI_PASSWORD=
SNEXI_HEADLESS=true           # set to false to watch the browser (debug)
SNEXI_ENRICH_DETAILS=true     # fetch individual OS detail pages (address, tenant…)

# ── Constatimmo ───────────────────────────────────────────────────────────────
CONSTATIMMO_URL=https://constatonline.constatimmo.com
CONSTATIMMO_USERNAME=
CONSTATIMMO_PASSWORD=
CONSTATIMMO_HEADLESS=true
CONSTATIMMO_ENRICH_DETAILS=true  # fetch individual ODM detail pages

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create a Desktop app OAuth client in Google Cloud Console.
# See README.md → "Google Cloud setup" for step-by-step instructions.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=./token.json   # generated on first run — do not commit

# ── Google Calendar ───────────────────────────────────────────────────────────
# "primary" = your default calendar.
# For a specific calendar: Settings → [calendar name] → Calendar ID
GOOGLE_CALENDAR_OS_ID=primary    # Snexi OS events (entrée / sortie)
GOOGLE_CALENDAR_ODM_ID=primary   # Constatimmo ODM events

# Event colours in Google Calendar (1–11)
# 5 = banana/yellow   11 = tomato/red
GOOGLE_COLOR_SNEXI=5
GOOGLE_COLOR_CONSTATIMMO=11

# ── Gmail drafts ──────────────────────────────────────────────────────────────
# When a Snexi event is synced → draft sent to Constatimmo contact (and vice-versa).
# Leave blank to disable drafts for that direction.
GMAIL_DRAFTS_ENABLED=true
CONSTATIMMO_CONTACT_EMAIL=       # notified when a Snexi OS event is created
SNEXI_CONTACT_EMAIL=             # notified when a Constatimmo ODM is created
SENDER_NAME=                     # your name, appears at the bottom of each draft

# ── Flags ─────────────────────────────────────────────────────────────────────
DRY_RUN=false    # true = preview only, nothing written to Google or Gmail
